rules_version = '2';

// Client access is denied intentionally. The SPA never reads or writes
// Firestore directly: every operation goes through the Express API, which
// verifies Firebase ID tokens and enforces workspace/resource authorization
// with the Admin SDK. The Admin SDK bypasses these rules.
//
// Re-enabling direct client access requires a full per-collection rules
// review; do not replace this with a blanket allow.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
