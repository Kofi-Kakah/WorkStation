# Frontend environment configuration.
# Copy to .env.local (gitignored). Vite exposes every VITE_* value in the
# browser bundle, so these values are public by design — never place secrets,
# API keys for server services, or service-account credentials here.

# Firebase web app configuration (Firebase Console > Project settings > Your apps).
VITE_FIREBASE_API_KEY=replace-with-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=workshop-111f1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=workshop-111f1
VITE_FIREBASE_STORAGE_BUCKET=workshop-111f1.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
VITE_FIREBASE_APP_ID=replace-with-web-app-id

# Browser push (Cloud Messaging) requires the public Web Push certificate key.
VITE_FIREBASE_VAPID_KEY=

# Set to true only for local development against the Firebase Emulator Suite.
VITE_USE_FIREBASE_EMULATOR=false

# Base URL for the Express API. Keep /api/v1 behind Firebase Hosting rewrites
# (same origin) or set an absolute URL when the API is hosted separately.
VITE_API_BASE=/api/v1
