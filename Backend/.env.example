# Backend environment configuration.
# Copy to .env and fill in values. NEVER commit secrets.

# Server
PORT=4000
NODE_ENV=development
API_VERSION=v1

# CORS — comma-separated list of allowed origins.
# In development the dev server is auto-allowed.
CORS_ORIGINS=http://localhost:5173

# Rate limiting (per client IP; uploads and auth endpoints have tighter limits)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Set to true when running behind one reverse-proxy hop (e.g. Cloud Run) so
# rate limiting sees the real client IP.
TRUST_PROXY=false

# Verified Firebase ID token cache. Revocations take effect within this window.
# Set 0 to verify (and check revocation for) every request.
AUTH_TOKEN_CACHE_MS=60000

# Logging
LOG_LEVEL=debug

# Firebase Admin — three modes:
#   1. FIREBASE_USE_EMULATOR=true  -> uses the Firebase Emulator Suite
#   2. FIREBASE_PROJECT_ID + FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY
#   3. GOOGLE_APPLICATION_CREDENTIALS (Application Default Credentials)
FIREBASE_USE_EMULATOR=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_BUCKET=workshop-111f1.firebasestorage.app

# Mode 2 — service account fields (NEVER commit these).
# FIREBASE_PROJECT_ID=workshop-111f1
# FIREBASE_CLIENT_EMAIL=service-account@workshop-111f1.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Production (Cloud Run) settings
# ---------------------------------------------------------------------------
# On Cloud Run, leave the emulator flag unset. The Admin SDK uses Application
# Default Credentials from the attached service account; no key file is needed.
# FIREBASE_USE_EMULATOR=false
# NODE_ENV=production
# PORT=8080
# TRUST_PROXY=true
# LOG_LEVEL=info
# CORS_ORIGINS=https://workshop-111f1.web.app,https://workshop-111f1.firebaseapp.com
# FIREBASE_PROJECT_ID=workshop-111f1
# FIREBASE_STORAGE_BUCKET=workshop-111f1.firebasestorage.app
