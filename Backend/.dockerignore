# Keep the build context small and free of credentials.
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Never copy local environment files or key material into the image.
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json

# Tests, logs, and editor state are not needed in the runtime image.
src/**/*.test.js
src/test
tests
coverage
logs
*.log
.vscode
.idea
.DS_Store
