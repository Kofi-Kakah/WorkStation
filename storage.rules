rules_version = '2';

// Client access is denied intentionally. Files are uploaded and downloaded
// only through authenticated Express endpoints. Downloads use short-lived
// signed URLs generated by the backend after an authorization check, and
// uploads are validated and stored by the Admin SDK. Objects are never public.
service firebase.storage {
  match /b/{bucket}/o {
    match /{object=**} {
      allow read, write: if false;
    }
  }
}
